<Window x:Class="UNO_Client_WPF.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lobby" Height="500" Width="800" Background="#1B263B" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
            <TextBox Name="tbRoomName" Width="200" Height="35" VerticalContentAlignment="Center"/>
            <Button Content="Tạo Phòng" Width="100" Margin="10,0" Click="btn_create_Click" Style="{StaticResource RoundedBtn}" Background="Green"/>
            <Button Content="Quay về" Width="80" Margin="10,0" Click="btn_back_Click" Style="{StaticResource RoundedBtn}" Background="Gray"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="White" BorderThickness="1" CornerRadius="5">
            <ScrollViewer>
                <ItemsControl Name="ListRooms">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="100" Background="#2C2B5A" Margin="10" CornerRadius="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding name}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding PlayerCountDisplay}" Foreground="LightGray"/>
                                    <Button Content="Join" Width="80" Margin="5" Click="btn_join_Click" Tag="{Binding}" Style="{StaticResource RoundedBtn}" Background="#5E94FF"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>