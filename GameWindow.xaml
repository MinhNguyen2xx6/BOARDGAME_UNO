<Window x:Class="UNO_Client_WPF.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNO Game" Height="720" Width="1280" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">

    <Window.Background>
        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FF640000" Offset="1.0"/>
            <GradientStop Color="#FFD42E2E" Offset="0.3"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Style cho lá bài -->

        <Style x:Key="CardStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="8" BorderBrush="White" BorderThickness="3" Background="White">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: nhích lên 0.5 cm (~19) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="-19" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Panel.ZIndex" Value="10"/>
                            </Trigger>

                            <!-- Được chọn: nhích lên 1 cm (~38) + viền xanh -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Panel.ZIndex" Value="20"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="LimeGreen"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-38"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>





        <!-- Style cho nút bấm -->
        <Style x:Key="GlossyBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="#FF0055AA" BorderBrush="White" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas Name="AnimationLayer" Panel.ZIndex="999" IsHitTestVisible="False" Margin="0,-20,0,20"/>

        <Grid Margin="0,-20,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <!-- Bot Top -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10">
                <Border Width="60" Height="60" CornerRadius="30" Background="#33000000" Margin="10">
                    <Image Source="/Assets/uno-classic-logo.jpg"/>
                </Border>
                <TextBlock Name="txtBotTopName" Text="Bot Top" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                <WrapPanel Name="BotTopHand" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Bot Left -->
            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10">
                <StackPanel.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#33000000">
                        <Image Source="/Assets/uno-classic-logo.jpg"/>
                    </Border>
                    <TextBlock Name="txtBotLeftName" Text="Bot Left" Foreground="White" VerticalAlignment="Center" Margin="5"/>
                    <WrapPanel Name="BotLeftHand" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>


            <!-- Bot Right -->
            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">
                <StackPanel.LayoutTransform>
                    <RotateTransform Angle="-90"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal">
                    <WrapPanel Name="BotRightHand" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Name="txtBotRightName" Text="Bot Right" Foreground="White" VerticalAlignment="Center" Margin="5"/>
                    <Border Width="50" Height="50" CornerRadius="25" Background="#33000000">
                        <Image Source="/Assets/uno-classic-logo.jpg"/>
                    </Border>
                </StackPanel>
            </StackPanel>



            <!-- Khu vực bàn chơi -->
            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Name="btnDrawPile" Grid.Column="0" Width="120" Height="170" 
                        Background="Transparent" BorderThickness="0" Click="btnDrawPile_Click">
                    <Image Source="/Assets/Deck.png" Stretch="Uniform"/>
                </Button>

                <Image Name="imgCurrentCard" Grid.Column="2" Width="120" Height="170" 
                       Source="/Assets/Blue_0.png" RenderTransformOrigin="0.5,0.5" Margin="143,0,-143,0">
                    <Image.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="5" Opacity="0.5"/>
                    </Image.Effect>
                    <Image.RenderTransform>
                        <RotateTransform Angle="10"/>
                    </Image.RenderTransform>
                </Image>

                <Button Name="btnSkip" Grid.ColumnSpan="3" Content="Bỏ lượt" Width="120" Height="40" 
                        Style="{StaticResource GlossyBtn}" Visibility="Collapsed" 
                        VerticalAlignment="Bottom" Margin="0,0,0,-60" />
                <TextBlock Name="txtTurnInfo" Text="Lượt: ?" 
           Foreground="Yellow" FontSize="20" FontWeight="Bold"
           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

            </Grid>

         <!-- Khu vực tay bài -->
<Grid Grid.Row="2" Grid.ColumnSpan="3">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="50"/>
    </Grid.ColumnDefinitions>

    <!-- Nút ĐÁNH -->
    <Button Name="btnPlayCard" Grid.Column="1" Content="ĐÁNH" Width="100" Height="60"
            VerticalAlignment="Top" Margin="0,20,0,0"
            Style="{StaticResource GlossyBtn}" Background="Green"
            Click="btnPlayCard_Click"
            Panel.ZIndex="20"/>

    <!-- Nút UNO -->
    <Button Name="btnUno" Content="UNO!" Width="100" Height="100"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-50,50,0"
            Background="Red" Foreground="Yellow" FontSize="24" FontWeight="Bold"
            Visibility="Collapsed" Click="btnUno_Click"
            Panel.ZIndex="20">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Ellipse Fill="Red" Stroke="Yellow" StrokeThickness="5"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Button.Template>
    </Button>

    <!-- HandPanel trong ScrollViewer -->
    <ScrollViewer Grid.ColumnSpan="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  VerticalAlignment="Bottom" Margin="0,0,0,-20">
        <WrapPanel Name="HandPanel" Orientation="Horizontal" Height="220"
                   HorizontalAlignment="Center" Margin="50,0,50,20"
                   ItemWidth="110" ItemHeight="160"/>
    </ScrollViewer>
</Grid>

        </Grid>

        <Button x:Name="btn_quit" Content="Quit" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Width="80" Height="30" Background="#99000000" Foreground="White" Click="btn_quit_Click"/>
    </Grid>
</Window>
