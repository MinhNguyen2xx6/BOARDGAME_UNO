<Window x:Class="UNO_Client_WPF.ColorChooser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn màu" Height="300" Width="300"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">

    <Border CornerRadius="15" Background="#E6222222" BorderBrush="White" BorderThickness="2" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CHỌN MÀU" Foreground="White" 
                       HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <UniformGrid Grid.Row="1" Columns="2" Rows="2">

                <Button Margin="5" Click="BtnColor_Click" Tag="Red" BorderBrush="White">
                    <Button.Background>
                        <SolidColorBrush Color="#FF5555"/>
                    </Button.Background>
                    <TextBlock Text="ĐỎ" Foreground="White" FontWeight="Bold"/>
                </Button>

                <Button Margin="5" Click="BtnColor_Click" Tag="Green" BorderBrush="White">
                    <Button.Background>
                        <SolidColorBrush Color="LimeGreen"/>
                    </Button.Background>
                    <TextBlock Text="XANH LÁ" Foreground="White" FontWeight="Bold"/>
                </Button>

                <Button Margin="5" Click="BtnColor_Click" Tag="Blue" BorderBrush="White">
                    <Button.Background>
                        <SolidColorBrush Color="#00AAFF"/>
                    </Button.Background>
                    <TextBlock Text="XANH DƯƠNG" Foreground="White" FontWeight="Bold"/>
                </Button>

                <Button Margin="5" Click="BtnColor_Click" Tag="Yellow" BorderBrush="White">
                    <Button.Background>
                        <SolidColorBrush Color="#FFAA00"/>
                    </Button.Background>
                    <TextBlock Text="VÀNG" Foreground="Black" FontWeight="Bold"/>
                </Button>

            </UniformGrid>
        </Grid>
    </Border>
</Window>