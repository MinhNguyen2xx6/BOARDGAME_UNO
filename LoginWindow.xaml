<Window x:Class="UNO_Client_WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="600" Width="800" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="InputBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="50"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2af598" Offset="0.0"/>
                <GradientStop Color="#009efd" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="20" Cursor="Hand"
                    Click="btn_exit_Click"/>

            <Border Width="380" CornerRadius="30" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="210,15,210,23" Background="#33FFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" Margin="30">

                    <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image Source="/Assets/FIX_Logo.png" 
           Width="168" 
           Height="150"
           Stretch="Uniform"
           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.509,0.323" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Sign In" FontSize="32" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0,0,0,30" Height="45"/>

                    <Border Style="{StaticResource InputBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#555"/>
                            <TextBox Name="tb_email" Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" 
                                     FontSize="14" Foreground="#333" Padding="5"/>
                            <TextBlock Text="Username / Email" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center" 
                                       Foreground="#888" Margin="5,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=tb_email}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InputBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔒" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#555"/>
                            <PasswordBox Name="pb_password" Grid.Column="1" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" 
                                         FontSize="14" Foreground="#333" Padding="5"/>
                            <TextBlock Text="👁" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#555" Cursor="Hand" ToolTip="Hiện mật khẩu"/>
                        </Grid>
                    </Border>

                    <Button Content="LOGIN" Height="50" Margin="0,20,0,10"
                            Foreground="White" FontSize="18" FontWeight="Bold" Cursor="Hand"
                            Click="btn_login_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="25" Background="#0f4c75">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Grid Margin="5,0">
                        <CheckBox Name="cb_remember" Content="Remember me" Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Text="Forgot password?" Foreground="White" HorizontalAlignment="Right" 
                        VerticalAlignment="Center" Cursor="Hand" TextDecorations="Underline"
                        MouseLeftButtonDown="btn_forgot_pass_Click"/>
                    </Grid>
                    <Button Content="Create Account" Background="Transparent" BorderThickness="0" Foreground="White" Click="btn_register_Click" Height="30" Width="322"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>